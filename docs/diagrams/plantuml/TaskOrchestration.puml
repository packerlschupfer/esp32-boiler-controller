@startuml TaskOrchestration
!include theme.puml

title Task Orchestration - 19 FreeRTOS Tasks\nEvent-Driven Architecture with Shared Resources

left to right direction

'' P = FreeRTOS priority. Stack in bytes for the default env esp32dev_usb_debug_selective
' (ProjectConfig.h; stack sizes differ per build profile). Cores from TaskInitializer, main.cpp.
package "Core 0" #2F4F4F {
    component [TimerSchedulerTask\nTimer schedules\nP:2, Stack:3072] as SchedulerTask
    component [MonitoringTask\nSystem Health\nP:2, Stack:3584] as MonitorTask
}

package "Core 1 - Hardware Interface" #8B4513 {
    component [MB8ARTTask\nSensor Polling\nP:4, Stack:3584] as MB8ARTTask
    component [MB8ARTProcessingTask\nData Processing\nP:3, Stack:3072] as MB8ARTProc
    component [ANDRTF3Task\nRoom Sensor\nP:3, Stack:3584] as ANDRTF3Task
    component [RelayControlTask\nRelay Commands\nP:4, Stack:4096] as RelayTask
    component [RYN4ProcessingTask\nRelay Modbus I/O\nP:3, Stack:2560] as RYN4Proc
}

package "Core 1 - Control Logic" #4682B4 {
    component [BurnerControlTask\nState Machine\nP:4, Stack:4096] as BurnerTask
    component [BoilerTempControlTask\nHeat demand arming + power level\nevery boiler sensor update (~2.5 s)\nP:4, Stack:3072] as BoilerTempTask
}

package "Core 1 - Services" #52BE80 {
    component [NTPTask\nTime Sync\nP:2, Stack:4096] as NTPTask
    component [MQTTTask\nCommunication\nP:2, Stack:3584] as MQTTTask
    component [OTATask\nFirmware Update\nP:1, Stack:3072] as OTATask
}

package "Not pinned to a core" #708090 {
    component [HeatingControlTask\nSpace Heating\nP:3, Stack:3584] as HeatingTask
    component [WheaterControlTask\nWater Heating\nP:3, Stack:3584] as WaterTask
    component [ControlTask\nRemote control\nP:3, Stack:3584] as ControlTask
    component [HeatingPumpTask\nPumpControlModule\nP:3, Stack:2048] as HeatPumpTask
    component [WaterPumpTask\nPumpControlModule\nP:3, Stack:2048] as WaterPumpTask
    component [PersistentStorageTask\nParameter Saves\nP:2, Stack:5120] as StorageTask
    component [SyslogTask\nRemote logging\nP:1, Stack:4096] as SyslogTask
    component [Arduino loop()] as LoopTask
}

component [PIDControlTask\nnot started in current code] as PIDTask

package "Shared Data Structures\n(Mutex Protected)" #8B7355 {
    storage [SharedSensorReadings\n8 Temperatures\nValidity Flags\nTemperature_t int16] as SensorData
    storage [SharedRelayReadings\n8 Relay States\nError Codes] as RelayData
    storage [SystemSettings\nAll Runtime Parameters\nUpdated via MQTT] as SystemSettings
}

package "Event Groups\n(FreeRTOS)" #708090 {
    storage [GeneralSystem\nSTARTUP_COMPLETE\nNETWORK_READY\nMQTT_CONNECTED\nSTORAGE_READY] as GeneralSys
    storage [SystemState\nBOILER/HEATING/WATER\nENABLED/ON bits\nEMERGENCY_STOP] as SystemState
    storage [BurnerRequest\nHEATING/WATER_REQUEST\nPOWER_LOW/HIGH\nTemp encoding 16-23] as BurnerReq
    storage [Sensor\n8 update bits\n8 error bits\nDATA_AVAILABLE] as SensorEvents
    storage [Relay\nRelay + RelayRequest\n8 relay ON/OFF\nUPDATE_REQUIRED\nEMERGENCY_STOP] as RelayEvents
}

package "SystemResourceProvider (SRP)\nService Locator" #68228B {
    component [SRP::get...()\ngetMB8ART()  getRYN4()  getANDRTF3()  getDS3231()\ngetBurnerSystemController()\ngetHeatingControl()  getWheaterControl()  getPIDControl()\ngetMQTTManager()  getRuntimeStorage()  getHealthMonitor()\nplus event group, mutex and shared data getters] as SRP
}

package "Hardware Devices\n(via SRP)" #CD5B45 {
    component [MB8ART\n8-Ch Temp Sensor\nModbus RTU] as MB8ART
    component [RYN4\n8-Ch Relay Module\nModbus RTU] as RYN4
    component [ANDRTF3\nRoom Sensor\nModbus RTU] as ANDRTF3
}

package "Control Modules\n(via SRP)" #FFD93D {
    component [BurnerSystemController\nBurner relays R1-R3] as BurnerSysCtrl
    component [HeatingControlModule\nPID + Heating Curve] as HeatingCtrl
    component [PIDControlModule\nFixed-Point PID] as PIDCtrl
}

component [StateManager\nsystem / water switches] as StateMgr

' Hardware Interface Flow
MB8ARTTask --> MB8ART : poll\n5s
MB8ART --> MB8ARTProc : raw data
MB8ARTProc --> SensorData : update
MB8ARTProc --> SensorEvents : SetBits

ANDRTF3Task --> ANDRTF3 : poll\n5s
ANDRTF3 --> SensorData : update
ANDRTF3 --> SensorEvents : SetBits

RelayTask --> RYN4Proc : desired relay states
RYN4Proc --> RYN4 : Modbus write
RYN4 --> RelayData : states
RelayTask --> RelayEvents : SetBits

' Control Logic Flow
HeatingTask --> SensorData : read
HeatingTask --> SystemSettings : read
HeatingTask --> BurnerReq : setHeatingRequest\nHEATING + POWER_LOW + target

WaterTask --> SensorData : read
WaterTask --> SystemSettings : read
WaterTask --> BurnerReq : setWaterRequest\nWATER + POWER_HIGH + target

BurnerTask --> BurnerReq : WaitBits
BurnerTask --> BurnerSysCtrl : control
BurnerSysCtrl --> RelayTask : setRelayState\nR1-R3
BurnerTask --> RelayEvents : SetBits

' Pumps follow the mode bits and request their relays
HeatPumpTask --> SystemState : follows HEATING_ON
WaterPumpTask --> SystemState : follows WATER_ON
HeatPumpTask --> RelayEvents : RelayRequest\nHEATING_PUMP_ON/OFF
WaterPumpTask --> RelayEvents : RelayRequest\nWATER_PUMP_ON/OFF

' Heat demand arming (BurnerDemandGate)
BurnerTask --> BoilerTempTask : demand permission
BoilerTempTask --> SensorData : read boiler temp
BoilerTempTask --> BurnerTask : arm / drop heat demand\n+ power level

' Switch-off ends a running water charge
StateMgr --> WaterTask : notifyWheaterTaskSwitchedOff()

' Service Flow
MQTTTask --> SystemSettings : read
MQTTTask --> SensorData : read
MQTTTask --> RelayData : read
MQTTTask --> GeneralSys : publish status

MonitorTask --> SensorData : collect
MonitorTask --> RelayData : collect
MonitorTask --> SystemState : check
MonitorTask --> MQTTTask : report

StorageTask --> SystemSettings : auto-save\n5 min

' Scheduler Flow
SchedulerTask --> SensorData : read tank temp
SchedulerTask --> BurnerReq : SetBits\nWATER_REQUEST

' SRP Access
HeatingTask ..> SRP : getHeatingControl()
BurnerTask ..> SRP : getBurnerSystemController()
MB8ARTTask ..> SRP : getMB8ART()
RelayTask ..> SRP : getRYN4()

SRP --> MB8ART
SRP --> RYN4
SRP --> ANDRTF3
SRP --> BurnerSysCtrl
SRP --> HeatingCtrl
SRP --> PIDCtrl

note right of SensorData
  Thread Safety:
  All shared data protected
  by mutexes via RAII pattern

  Temperature Format:
  Temperature_t = int16_t
  Resolution: 0.1°C
  No float arithmetic
end note

note right of BurnerReq
  Temperature Encoding:
  Bits 0-15: Control flags
  Bits 16-23: Target temp

  Example: 70°C heating
  = 0x00460001 (bit 0 + 70 << 16)

  Atomic Operation:
  Request + temperature
  in single SetBits call
end note

note bottom of BurnerTask
  Priority Arbitration:
  1. Read HEATING / WATER request bits
  2. Water wins when WATER_PRIORITY is set
     or there is no heating request
  3. Decode target temperature and POWER_HIGH
  4. Publish the demand permission
  5. BurnerStateMachine drives BurnerSystemController
  Event-driven with a 1 s safety timer
end note

note bottom of SRP
  Service Locator Pattern:
  - O(1) static access
  - Compile-time type safety
  - No ServiceContainer overhead
  - Replaced HashMap lookup

  All tasks access services
  via SRP::getXXX() calls
end note

@enduml
