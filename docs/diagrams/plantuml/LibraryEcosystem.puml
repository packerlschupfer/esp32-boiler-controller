@startuml LibraryEcosystem
!include theme.puml

title ESP32 Library Ecosystem - 21 Custom Libraries\nDependencies from each library.json and #include lines

legend right
  |<#2F4F2F> Foundation |
  |<#4682B4> Core Infrastructure |
  |<#52BE80> Network Services |
  |<#8B4513> Storage Services |
  |<#CD5B45> Modbus Framework |
  |<#708090> External Libraries |
endlegend

package "Application" #8B2500 {
    component [main.cpp and src/\nSystemInitializer\n19 FreeRTOS tasks] as MainApp
}

package "Foundation" #2F4F2F {
    component [ESP32-LibraryCommon] as LibCommon
    component [ESP32-Logger] as Logger
    component [ESP32-MutexGuard] as MutexGuard
    component [ESP32-SemaphoreGuard] as SemaphoreGuard
    component [ESP32-Watchdog] as Watchdog
}

package "Core Infrastructure" #4682B4 {
    component [ESP32-TaskManager] as TaskManager
    component [ESP32-Syslog] as Syslog
}

package "Network Services" #52BE80 {
    component [ESP32-EthernetManager\nLAN8720, static IP in this project] as EthernetMgr
    component [ESP32-OTAManager] as OTAMgr
    component [ESP32-NTPClient] as NTPClient
    component [ESP32-MQTTClient] as MQTTClient
    component [ESP32-MQTTManager] as MQTTMgr
}

package "Storage Services" #8B4513 {
    component [ESP32-PersistentStorage\nNVS parameters via Preferences] as PersistentStorage
    component [ESP32-RuntimeStorage\nFRAM MB85RC256V, 32KB] as RuntimeStorage
    component [ESP32-DS3231Controller\nDS3231 RTC] as DS3231Ctrl
}

package "Modbus Framework" #CD5B45 {
    component [esp32ModbusRTU\nfork] as esp32ModbusRTU
    component [ESP32-IDeviceInstance] as IDevice
    component [ESP32-ModbusDevice] as ModbusDevice
    component [ESP32-MB8ART\n8-channel temperature] as MB8ART
    component [ESP32-RYN4\n8-channel relay] as RYN4
    component [ESP32-ANDRTF3\nroom sensor] as ANDRTF3
}

package "External Dependencies" #708090 {
    component [ArduinoJson 7] as ArduinoJSON
    component [RTClib] as RTClib
    component [Adafruit BusIO] as BusIO
    component [Arduino-ESP32 framework\nWire, WiFi, Preferences] as Framework
}

' Libraries the application includes directly (#include in src/ and include/)
MainApp --> Logger
MainApp --> MutexGuard
MainApp --> SemaphoreGuard
MainApp --> Watchdog
MainApp --> TaskManager
MainApp --> Syslog
MainApp --> EthernetMgr
MainApp --> OTAMgr
MainApp --> NTPClient
MainApp --> MQTTClient
MainApp --> MQTTMgr
MainApp --> PersistentStorage
MainApp --> RuntimeStorage
MainApp --> DS3231Ctrl
MainApp --> esp32ModbusRTU
MainApp --> IDevice
MainApp --> ModbusDevice
MainApp --> MB8ART
MainApp --> RYN4
MainApp --> ANDRTF3
MainApp --> ArduinoJSON

' library.json dependencies (solid)
TaskManager --> Watchdog
TaskManager --> MutexGuard
Syslog --> Logger
EthernetMgr --> MutexGuard
EthernetMgr --> LibCommon
OTAMgr --> MutexGuard
MQTTMgr --> LibCommon
MQTTMgr --> MQTTClient
PersistentStorage --> ArduinoJSON
RuntimeStorage --> Framework : Wire
DS3231Ctrl --> BusIO
DS3231Ctrl --> RTClib
DS3231Ctrl --> MutexGuard
IDevice --> LibCommon
ModbusDevice --> MutexGuard
ModbusDevice --> LibCommon
ModbusDevice --> IDevice
ModbusDevice --> esp32ModbusRTU
MB8ART --> esp32ModbusRTU
MB8ART --> ModbusDevice
MB8ART --> MutexGuard
MB8ART --> IDevice
RYN4 --> ModbusDevice
RYN4 --> MutexGuard
RYN4 --> LibCommon
ANDRTF3 --> ModbusDevice
ANDRTF3 --> IDevice
ANDRTF3 --> MutexGuard

' #include without a library.json entry (dashed)
esp32ModbusRTU ..> Logger
esp32ModbusRTU ..> Watchdog
NTPClient ..> Logger
RuntimeStorage ..> MutexGuard
RYN4 ..> IDevice

note right of MainApp
  platformio.ini lib_deps: 21 custom libraries
  (including the esp32ModbusRTU fork) plus
  ArduinoJson. RTClib and Adafruit BusIO come
  in through ESP32-DS3231Controller.

  MainApp edges: libraries the application
  includes directly (ESP32-LibraryCommon only
  indirectly). Library edges: library.json
  dependencies (solid) or #include only (dashed).

  PubSubClient is not used; MQTT goes through
  ESP32-MQTTClient and ESP32-MQTTManager.
  Lines of code and history: not verified.
end note

@enduml
